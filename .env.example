# Server
PORT=3000
# development | production
NODE_ENV=

# Email Configuration (Gmail account + app password)
MAIL_USER=
MAIL_PASS=
# Set to true to also send a copy of each contact message to MAIL_USER
MAIL_NOTIFY_OWNER=false

# Chatbot Configuration
CHATBOT_ENDPOINT=

# API Security (max contact requests per IP every 15 minutes)
CONTACT_RATE_LIMIT_MAX=10
